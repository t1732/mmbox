{
  "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
  "files": {
    "includes": [
      "biome.json",
      "postcss.config.js",
      "tsconfig.json",
      "vite.config.ts",
      "webui/**/*.{ts,tsx}"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              { "type": false, "source": ["react*", "react/**"] },
              { "type": false, "source": ":NODE:" },
              { "type": false, "source": ":PACKAGE:" },
              ":BLANK_LINE:",

              { "type": false },
              ":BLANK_LINE:",

              { "type": true }
            ]
          }
        }
      }
    }
  }
}
